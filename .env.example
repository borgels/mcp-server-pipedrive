# The personal API token of a Pipedrive user (Personal preferences > API). It carries
# that user's permissions in that company.
PIPEDRIVE_API_TOKEN=
# PIPEDRIVE_BASE_URL=https://api.pipedrive.com
PIPEDRIVE_TIMEOUT_MS=30000
PIPEDRIVE_MAX_CONCURRENCY=4
# Largest response body read from the upstream API (bytes, max 104857600).
PIPEDRIVE_MAX_RESPONSE_BYTES=10485760

# Write tools are disabled unless this is true.
PIPEDRIVE_ENABLE_WRITES=false
# Comma-separated tool names to disable (with or without the pipedrive_ prefix).
PIPEDRIVE_DISABLED_TOOLS=
# JSONL audit trail; write tools refuse to run if it cannot be written.
PIPEDRIVE_AUDIT_LOG=

# HTTP transport. A bearer token (>= 32 printable ASCII characters, e.g.
# `openssl rand -hex 32`) is required unless the server binds to loopback.
MCP_HTTP_TOKEN=
# Bind address (HOST is also read; MCP_HTTP_HOST wins):
# MCP_HTTP_HOST=127.0.0.1
# PORT=3000
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOWED_HOSTS=
# MCP_MAX_BODY_BYTES=10485760
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
# Allow any browser origin (requires a token):
# MCP_ALLOW_ANY_ORIGIN=false
# Non-loopback bind without a token; isolated networks only:
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false
